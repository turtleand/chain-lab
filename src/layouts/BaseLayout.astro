---
import '../styles/global.css';

const { title = 'Chain Lab', description = 'Blockchain exploration lab by Turtleand' } = Astro.props;
const pageTitle = title === 'Chain Lab' ? title : `${title} | Chain Lab`;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Turtleand Chain Lab RSS" href="/rss.xml" />
    <script src="/scripts/theme.js" is:inline></script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-shell">
        <a class="brand" href="/" aria-label="Chain Lab home">
          <span class="brand-mark" aria-hidden="true">◇</span>
          <span>Chain Lab</span>
        </a>
        <div class="header-actions">
          <nav aria-label="Primary navigation">
            <a href="/">Articles</a>
            <a href="https://turtleand.com">Turtleand</a>
          </nav>
          <button class="theme-toggle" data-theme-toggle type="button" aria-label="Toggle theme">
            <span aria-hidden="true">◐</span>
          </button>
        </div>
      </div>
    </header>
    <main>
      <div class="shell"><slot /></div>
    </main>
    <footer>
      <div class="shell footer-shell">
        <span>© {new Date().getFullYear()} Turtleand</span>
        <span>Blockchain notes for trust, settlement, and digital agency.</span>
      </div>
    </footer>
  </body>
</html>
