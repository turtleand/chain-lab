---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const topicSlugFromEntry = (topic) => topic.slug ?? topic.id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '');
const formatDate = (date) => date.toISOString().slice(0, 10);

export const prerender = true;

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({
    params: { slug: topic.slug ?? topic.id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '') },
    props: { topic }
  }));
}

const { topic } = Astro.props;
const topicSlug = topicSlugFromEntry(topic);
const { Content } = await render(topic);
---

<BaseLayout title={topic.data.title} description={topic.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": topic.data.title,
    "description": topic.data.description,
    "datePublished": formatDate(topic.data.date),
    "author": { "@type": "Person", "name": "Turtleand", "url": "https://turtleand.com" },
    "isAccessibleForFree": true,
    "url": `https://chain.turtleand.com/topics/${topicSlug}`
  })} />
  <article class="article-shell">
    <header class="article-header">
      <div class="article-meta">
        <a class="back-link" href="/">← Articles</a>
        <time datetime={formatDate(topic.data.date)}>{formatDate(topic.data.date)}</time>
      </div>
      <p class="eyebrow">Chain Lab field note</p>
      <h1>{topic.data.title}</h1>
      <p>{topic.data.description}</p>
      <div class="tag-row" aria-label="Topic tags">
        {topic.data.tags.map((tag) => <em>{tag}</em>)}
      </div>
    </header>

    <div class="article-grid">
      <aside class="article-aside" aria-label="Reading frame">
        <div class="aside-card">
          <span class="aside-label">Reading lens</span>
          <strong>What trust work is happening here?</strong>
          <p>Look for settlement, custody, verification, governance, and user agency.</p>
        </div>
      </aside>
      <div class="content-article">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
